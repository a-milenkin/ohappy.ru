# Публичный адрес сайта (для ссылок и колбэков Suno)
NEXT_PUBLIC_SITE_URL=https://ohappy.ru

# Claude — пишет текст песни и стиль для Suno. Без ключа — демо-текст по шаблону.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# kie.ai — генерация музыки Suno. Без ключа — демо-режим с тестовым треком.
KIE_API_KEY=
SUNO_MODEL_STANDARD=V6_MINI
SUNO_MODEL_PREMIUM=V6

# Хранилище песен. Без него — файлы в .data/ (только для локальной разработки).
# Подходит Upstash Redis / Vercel KV (REST).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Сколько бесплатных генераций в сутки с одного IP
FREE_SONGS_PER_DAY=5
